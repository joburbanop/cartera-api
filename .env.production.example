# Plantilla de entorno para PRODUCCIÓN (VPS Hostinger)
# Copia a .env en el servidor:  cp .env.production.example .env
# Rellena las contraseñas reales. NUNCA subas el .env al repositorio.
#
# Leyenda: [OBLIGATORIA] hay que definirla. [OPCIONAL] tiene default razonable.

# --- Aplicación [OBLIGATORIA] ---
APP_NAME="SGC Casas y Lotes"
APP_ENV=production
APP_KEY=
# Generar en el servidor: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.casasylotes.com.co

# Zona civil de Colombia. [OBLIGATORIA] aunque config/app.php ya default a America/Bogota.
# Si queda UTC, "hoy" cambia a las 19:00 COT y la mora/recaudo mensual se desfasarían.
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# --- CORS [OBLIGATORIA] ---
# Origen exacto del front. Nunca uses *. Definir ANTES de php artisan config:cache.
CORS_ALLOWED_ORIGINS=https://cartera.casasylotes.com.co

# --- Base de datos PostgreSQL [OBLIGATORIA] ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cartera
DB_USERNAME=cartera
DB_PASSWORD=

# --- Logs [OBLIGATORIA LOG_LEVEL] ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Sanctum [OBLIGATORIA en espíritu; el default es 5] ---
# Minutos sin peticiones para revocar el token. Se lee vía config/sanctum.php
# (sí sobrevive a php artisan config:cache).
SANCTUM_TOKEN_INACTIVITY=5
# SPA Bearer: no hace falta cookie stateful. Si algún día usas cookies:
# SANCTUM_STATEFUL_DOMAINS=cartera.casasylotes.com.co

# --- Sesión / caché / colas ---
# Las tablas sessions, cache y jobs las crea migrate. Hoy NO hay jobs en app/Jobs;
# QUEUE_CONNECTION=database no exige un worker en marcha.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Correo [OPCIONAL] ---
# En prod conviene smtp real; log solo escribe a storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@casasylotes.com.co"
MAIL_FROM_NAME="${APP_NAME}"

# --- Semilla de usuarios demo [NO USAR EN PRODUCTION] ---
# DatabaseSeeder sale en cuanto APP_ENV=production. No definas SEED_USER_PASSWORD aquí.
# El primer usuario se crea con: php artisan user:create ...

# --- Activity log [OPCIONAL] ---
# ACTIVITYLOG_ENABLED=true
# ACTIVITYLOG_BUFFER_ENABLED=false

# --- Mantenimiento [OPCIONAL] ---
APP_MAINTENANCE_DRIVER=file
